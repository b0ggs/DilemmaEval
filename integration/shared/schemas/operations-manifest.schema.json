{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dilemmaeval.local/schemas/operations-manifest.schema.json",
  "title": "DilemmaEval public operations-wallet manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "network",
    "chain_id",
    "phase_advancer",
    "gas_ceiling_wei"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "network": { "const": "base-sepolia" },
    "chain_id": { "const": 84532 },
    "phase_advancer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "wallet_address",
        "is_player_seat",
        "erc8004_registered"
      ],
      "properties": {
        "role": { "const": "phase-advancer" },
        "wallet_address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "is_player_seat": { "const": false },
        "erc8004_registered": { "const": false }
      }
    },
    "gas_ceiling_wei": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    }
  }
}
