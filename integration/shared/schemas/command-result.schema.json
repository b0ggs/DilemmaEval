{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dilemmaeval.local/schemas/command-result.schema.json",
  "title": "Pinned game command result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "command",
    "args",
    "exit_code",
    "signal",
    "stdout",
    "stderr",
    "parsed",
    "error"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": {
      "enum": [
        "state",
        "wallet_auth_status",
        "register",
        "join",
        "prepare_commit",
        "commit",
        "reveal",
        "advance",
        "claim"
      ]
    },
    "command": { "type": "string", "minLength": 1 },
    "args": { "type": "array", "items": { "type": "string" } },
    "exit_code": { "type": ["integer", "null"] },
    "signal": { "type": ["string", "null"] },
    "stdout": { "type": "string" },
    "stderr": { "type": "string" },
    "parsed": {},
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
