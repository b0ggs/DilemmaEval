{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dilemmaeval.local/schemas/seat-manifest.schema.json",
  "title": "DilemmaEval public seat manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "network", "game_id", "seats"],
  "properties": {
    "schema_version": { "const": 1 },
    "network": { "const": "base-sepolia" },
    "game_id": { "type": "string", "minLength": 1 },
    "seats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seat_id",
          "team",
          "harness",
          "maritime_agent",
          "wallet_address"
        ],
        "properties": {
          "seat_id": { "type": "string", "pattern": "^(oc|hs)-[1-5]$" },
          "team": { "enum": ["openclaw", "hermes"] },
          "harness": { "enum": ["openclaw", "hermes"] },
          "maritime_agent": { "type": "string", "minLength": 1 },
          "wallet_address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "team": { "const": "openclaw" } } },
            "then": {
              "properties": {
                "seat_id": { "pattern": "^oc-[1-5]$" },
                "harness": { "const": "openclaw" }
              }
            }
          },
          {
            "if": { "properties": { "team": { "const": "hermes" } } },
            "then": {
              "properties": {
                "seat_id": { "pattern": "^hs-[1-5]$" },
                "harness": { "const": "hermes" }
              }
            }
          }
        ]
      }
    }
  }
}
